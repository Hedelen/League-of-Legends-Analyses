# Riot development keys expire about every 24 hours. Never commit your real key.
RIOT_API_KEY=RGAPI-your-key-here

# This project always writes to the separate kayle_analysis database.
POSTGRES_DSN=postgresql://postgres:your_password@localhost:5432/kayle_analysis

RIOT_PLATFORM=na1
RIOT_ROUTING=americas
SELF_ACCOUNTS=YourGameName#YourTag

# A fixed snapshot of the OP.GG NA Kayle top 50 supplies only candidate Riot IDs.
# Riot validates every fact used by the database and analysis.
TARGET_REFERENCE_PLAYERS=50
MIN_KAYLE_MASTERY_POINTS=10000
MIN_REFERENCE_KAYLE_GAMES=5
REFERENCE_MATCHES_TO_SCREEN=100
SELF_MAX_MATCHES=300
TARGET_GAMES_PER_RANK=300
MAX_GAMES_PER_REFERENCE_PLAYER=100
VERY_SHORT_GAME_SECONDS=300
HTTP_TIMEOUT_SECONDS=30
MAX_HTTP_RETRIES=7
